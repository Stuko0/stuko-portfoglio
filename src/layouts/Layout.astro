---
import '../styles/global.css';
import RightNav from '../components/islands/RightNav';
import ScrollReveal from '../components/islands/ScrollReveal';
import { navLinks } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
}

const {
  title = 'Alexander Porcel — AI Systems Engineer',
  description = 'AI Systems Engineer building distributed backends, GPU inference systems, and high-throughput data pipelines. Golang, Python, CUDA, Kubernetes.',
  locale = 'en',
} = Astro.props;

const nl = navLinks();
const canonicalUrl = `https://stuko.dev/${locale}/`;
const ogImage = 'https://stuko.dev/images/og-preview.png';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0508" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="en" href="https://stuko.dev/en/" />
    <link rel="alternate" hreflang="es" href="https://stuko.dev/es/" />
    <link rel="alternate" hreflang="x-default" href="https://stuko.dev/en/" />

    <!-- Google Fonts: italic variant added for Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alexander Porcel — AI Systems Engineer portfolio" />
    <meta property="og:locale" content={locale === 'es' ? 'es_BO' : 'en_US'} />
    <meta property="og:site_name" content="Stuko · Alexander Porcel" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Alexander Porcel — AI Systems Engineer portfolio" />

    <title>{title}</title>

    <!-- JSON-LD: Person structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alexander Porcel",
      "alternateName": "Stuko",
      "url": "https://stuko.dev",
      "email": "avplaying@gmail.com",
      "jobTitle": "AI Systems Engineer",
      "description": "AI Systems Engineer building distributed backends, GPU inference systems, and high-throughput data pipelines.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cochabamba",
        "addressCountry": "BO"
      },
      "sameAs": [
        "https://github.com/Stuko0",
        "https://alice-agent.stuko.dev"
      ],
      "knowsAbout": [
        "Golang","Python","CUDA","Kubernetes","GPU Inference",
        "Distributed Systems","AI Agents","TensorFlow","PostgreSQL","Flutter"
      ]
    })} />
  </head>
  <body>
    <div class="wrapper">
      <RightNav client:load locale={locale} navLinks={nl} />
      <div class="main-content relative">
        <div class="bg-watermark" aria-hidden="true">♡</div>
        <!-- Floating background decorations -->
        <svg class="bg-filigree bg-filigree-left" viewBox="0 0 200 400" fill="currentColor" aria-hidden="true">
          <path d="M50,0 Q30,60 60,100 Q90,140 50,200 Q10,260 70,320 Q100,360 50,400" stroke="currentColor" stroke-width="1" fill="none"/>
          <circle cx="55" cy="100" r="12" opacity="0.5"/>
          <path d="M60,100 Q80,120 50,140" stroke="currentColor" stroke-width="1" fill="none" opacity="0.6"/>
          <path d="M55,50 L65,55" stroke="currentColor" stroke-width="2" opacity="0.4"/>
        </svg>
        <svg class="bg-filigree bg-filigree-right" viewBox="0 0 200 400" fill="currentColor" aria-hidden="true">
          <path d="M150,0 Q170,60 140,100 Q110,140 150,200 Q190,260 130,320 Q100,360 150,400" stroke="currentColor" stroke-width="1" fill="none"/>
          <circle cx="145" cy="200" r="10" opacity="0.4"/>
          <path d="M145,170 L135,175" stroke="currentColor" stroke-width="2" opacity="0.3"/>
        </svg>
        <slot />
      </div>
    </div>
    <ScrollReveal client:load />
  </body>
</html>
