---
import '../styles/global.css';
import RightNav from '../components/islands/RightNav';
import ScrollReveal from '../components/islands/ScrollReveal';
import { navLinks } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
}

const {
  title = 'Stuko — Portfolio',
  description = 'Diseño digital con alma oscura. Experiencias elegantes inspiradas en Alice: Madness Returns.',
  locale = 'en',
} = Astro.props;

const nl = navLinks();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0508" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Poppins:wght@400;500;600&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrapper">
      <RightNav client:load locale={locale} navLinks={nl} />
      <div class="main-content relative">
        <slot />
      </div>
    </div>
    <ScrollReveal client:load />
  </body>
</html>
