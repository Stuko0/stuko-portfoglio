---
import { partners } from '../../data/content';
const p = partners();
---

<section class="section section-partners" id="partners">
  <div class="tf-container">
    <div class="content-col">
      <div class="text-body-2 dot-before subtitle">Where I Build</div>
      <h2 class="desc reveal">
        Shipping production systems for finance, mobile products, and open-source AI tooling
      </h2>
      <div class="partners-grid">
        {p.map((pname: string) => (
          <div class="partners-item reveal">{pname}</div>
        ))}
      </div>
    </div>
  </div>
</section>
