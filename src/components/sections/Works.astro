---
import { works } from '../../data/content';
import { Suit } from '../islands/HeartlessSVGs';

const w = works();

const suits = ['spade', 'heart', 'diamond', 'club'] as const;
type SuitType = (typeof suits)[number];
const redSuits: SuitType[] = ['heart', 'diamond'];
const ranks = ['A', 'K', 'Q', 'J', '10', '9', '8', '7'];
---

<section class="section section-selected-works" id="works">
  <div class="tf-container">
    <div class="content-col">
      <div class="text-body-2 dot-before subtitle">Featured Works</div>
      <h2 class="desc reveal" style="margin-bottom: 3rem;">
        The Royal Deck — each project is a playing card in the kingdom
      </h2>

      <div class="works-cards-grid">
        {w.map((work: any, i: number) => {
          const tsuit = suits[i % suits.length];
          const rank = ranks[i % ranks.length];
          const isRed = redSuits.includes(tsuit);
          const isExternal = work.href.startsWith('http');
          return (
            <a
              href={work.href}
              class={`royal-card reveal ${isRed ? 'suit-red' : 'suit-black'}`}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              <div class="card-bg" style={`background: ${work.gradient};`}></div>

              {/* Faint suit watermark printed on the face */}
              <Suit type={tsuit} className="suit-watermark" size={110} />

              {/* Corner index: rank + suit, like a real playing card */}
              <span class="card-rank rank-tl" aria-hidden="true">{rank}</span>
              <Suit type={tsuit} className="suit-corner suit-tl" size={16} />
              <span class="card-rank rank-br" aria-hidden="true">{rank}</span>
              <Suit type={tsuit} className="suit-corner suit-br" size={16} />

              <div class="card-date">{work.date}</div>

              <div class="card-content">
                <div class="card-category">{work.category}</div>
                <h3 class="card-title">{work.title}</h3>
                {work.blurb && <p class="card-blurb">{work.blurb}</p>}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
