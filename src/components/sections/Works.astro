---
import { works } from '../../data/content';
const w = works();

const marqueeItems = Array.from({ length: 6 }, () => 'Selected Work');
---

<section class="section section-selected-works" id="works">
  <div class="tf-container">
    <div class="content-col">
      <div class="banner-slider" aria-hidden="true">
        <div class="marquee">
          <div class="marquee-track">
            {marqueeItems.map((text) => (
              <>
                <span class="banner-text text-display-2 fw-medium">{text}</span>
                <span class="dot-circle"></span>
              </>
            ))}
          </div>
          <div class="marquee-track">
            {marqueeItems.map((text) => (
              <>
                <span class="banner-text text-display-2 fw-medium">{text}</span>
                <span class="dot-circle"></span>
              </>
            ))}
          </div>
        </div>
      </div>

      <div class="works-wrap">
        {w.map((work: any) => (
          <a
            href={work.href}
            class="works-item reveal"
            target={work.href.startsWith('http') ? '_blank' : undefined}
            rel={work.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <div class="image">
              <div class="image-bg" style={`background: ${work.gradient};`}></div>
              <span class="arrow" aria-hidden="true">↗</span>
            </div>
            <div class="works-meta">
              <div>
                <div class="category text-body-2">{work.category}</div>
                <h3 class="title">{work.title}</h3>
                {work.blurb && <p class="work-blurb text-body-2">{work.blurb}</p>}
              </div>
              <div class="date">{work.date}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .work-blurb {
    color: var(--muted);
    margin-top: 0.8rem;
    max-width: 42rem;
    line-height: 1.5;
  }
</style>
