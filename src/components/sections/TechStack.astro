---
import { techStack } from '../../data/content';
const ts = techStack();
---

<section class="section section-tech-stack" id="tech">
  <div class="tf-container">
    <div class="content-col">
      <div class="text-body-2 dot-before subtitle">Core Stack</div>
      <div class="tech-grid">
        {ts.map((tech: any) => (
          <div class="tech-stack-item reveal">
            <div class="logo">{tech.name.charAt(0)}</div>
            <div class="name">{tech.name}</div>
            <div class="desc">{tech.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
