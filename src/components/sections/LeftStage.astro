---
/** Fixed left stage — mirrors Jayden's offset layout with Alice gothic ornament */
---

<aside class="left-stage" aria-hidden="true">
  <div class="left-stage-inner">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="ring ring-outer"></div>
    <div class="ring ring-mid"></div>
    <div class="ring ring-inner"></div>
    <div class="cross">
      <span></span>
      <span></span>
    </div>
    <div class="stage-label">
      <span class="dot-before">Stuko</span>
      <span class="year">AI Systems</span>
    </div>
  </div>
</aside>

<style>
  .left-stage {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 38%;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  @media (min-width: 1200px) {
    .left-stage {
      display: block;
    }
  }

  .left-stage-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .orb-1 {
    width: min(28vw, 36rem);
    height: min(28vw, 36rem);
    background: radial-gradient(circle at 35% 35%, #e8364f 0%, #7a1528 40%, transparent 70%);
    opacity: 0.55;
    animation: float 8s ease-in-out infinite;
  }

  .orb-2 {
    width: min(16vw, 20rem);
    height: min(16vw, 20rem);
    background: radial-gradient(circle at 40% 40%, #c4a35a 0%, transparent 70%);
    opacity: 0.25;
    top: 28%;
    left: 22%;
    animation: float 11s ease-in-out infinite reverse;
  }

  .orb-3 {
    width: min(12vw, 14rem);
    height: min(12vw, 14rem);
    background: radial-gradient(circle, rgba(196, 30, 58, 0.5) 0%, transparent 70%);
    bottom: 24%;
    right: 18%;
    animation: float 9s ease-in-out infinite 1s;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(196, 30, 58, 0.25);
  }

  .ring-outer {
    width: min(32vw, 42rem);
    height: min(32vw, 42rem);
    border-color: rgba(196, 163, 90, 0.2);
    animation: spin 40s linear infinite;
  }

  .ring-mid {
    width: min(24vw, 30rem);
    height: min(24vw, 30rem);
    border-style: dashed;
    animation: spin 28s linear infinite reverse;
  }

  .ring-inner {
    width: min(14vw, 18rem);
    height: min(14vw, 18rem);
    border-color: rgba(232, 54, 79, 0.35);
    animation: spin 18s linear infinite;
  }

  .cross {
    position: absolute;
    width: min(20vw, 24rem);
    height: min(20vw, 24rem);
  }

  .cross span {
    position: absolute;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(196, 163, 90, 0.35),
      transparent
    );
  }

  .cross span:first-child {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-50%);
  }

  .cross span:last-child {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
      180deg,
      transparent,
      rgba(196, 163, 90, 0.35),
      transparent
    );
  }

  .stage-label {
    position: absolute;
    bottom: 4.8rem;
    left: 4.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 1.3rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stage-label .year {
    padding-left: 1.7rem;
    color: var(--gold);
    opacity: 0.7;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-18px) scale(1.03);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
