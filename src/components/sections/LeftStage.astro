---
/** Left stage — Heartless (Marissa Meyer) aesthetic: 
    white/red/black roses, thorn vines, crown silhouette, playing card hearts */
---

<aside class="left-stage" aria-hidden="true">
  <div class="left-stage-inner">
    <!-- Crown silhouette -->
    <div class="crown-silhouette" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    
    <!-- Floating hearts (playing card style) -->
    <div class="heart heart-1">♥</div>
    <div class="heart heart-2">♥</div>
    <div class="heart heart-3">♡</div>
    
    <!-- Orb glow -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    
    <!-- Rings -->
    <div class="ring ring-outer"></div>
    <div class="ring ring-mid"></div>
    <div class="ring ring-inner"></div>
    
    <!-- Thorn vine cross -->
    <div class="vine-cross">
      <div class="vine vine-h"><span class="thorn thorn-l"></span><span class="thorn thorn-r"></span></div>
      <div class="vine vine-v"><span class="thorn thorn-u"></span><span class="thorn thorn-d"></span></div>
      <div class="rose-blossom rose-top">✧</div>
      <div class="rose-blossom rose-bottom">✧</div>
    </div>

    <!-- Stage label -->
    <div class="stage-label">
      <span class="dot-before">Stuko</span>
      <span class="year">♛ AI Systems</span>
    </div>
    
    <!-- Corner rose clusters -->
    <div class="corner-rose corner-tr">
      <span class="rose-icon">✧</span>
      <span class="thorn-line"></span>
    </div>
    <div class="corner-rose corner-bl">
      <span class="rose-icon">✧</span>
      <span class="thorn-line"></span>
    </div>
  </div>
</aside>

<style>
  .left-stage {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 38%;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  @media (min-width: 1200px) {
    .left-stage {
      display: block;
    }
  }

  .left-stage-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ======== CROWN SILHOUETTE ======== */
  .crown-silhouette {
    position: absolute;
    top: 6%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-end;
    gap: 0;
    opacity: 0.08;
  }

  .crown-silhouette span {
    width: 2.8rem;
    height: 6rem;
    background: var(--gold);
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .crown-silhouette span:nth-child(1) { height: 4rem; }
  .crown-silhouette span:nth-child(2) { height: 6rem; }
  .crown-silhouette span:nth-child(3) { height: 8rem; width: 3.6rem; }
  .crown-silhouette span:nth-child(4) { height: 6rem; }
  .crown-silhouette span:nth-child(5) { height: 4rem; }

  /* ======== FLOATING HEARTS ======== */
  .heart {
    position: absolute;
    font-size: 3.2rem;
    opacity: 0.12;
    pointer-events: none;
    animation: floatHeart 7s ease-in-out infinite;
  }

  .heart-1 {
    top: 15%;
    right: 12%;
    color: var(--primary-bright);
    font-size: 4rem;
    animation-delay: 0s;
  }

  .heart-2 {
    bottom: 20%;
    left: 10%;
    color: var(--white);
    font-size: 2.8rem;
    animation-delay: 2.3s;
    opacity: 0.06;
  }

  .heart-3 {
    top: 40%;
    left: 55%;
    color: var(--primary);
    font-size: 2rem;
    animation-delay: 4.7s;
    opacity: 0.08;
  }

  @keyframes floatHeart {
    0%, 100% { transform: translateY(0) rotate(-5deg) scale(1); }
    50% { transform: translateY(-16px) rotate(5deg) scale(1.08); }
  }

  /* ======== ORBS ======== */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .orb-1 {
    width: min(28vw, 36rem);
    height: min(28vw, 36rem);
    background: radial-gradient(circle at 35% 35%, #e8364f 0%, #7a1528 40%, transparent 70%);
    opacity: 0.45;
    animation: float 8s ease-in-out infinite;
  }

  .orb-2 {
    width: min(16vw, 20rem);
    height: min(16vw, 20rem);
    background: radial-gradient(circle at 40% 40%, #c4a35a 0%, transparent 70%);
    opacity: 0.2;
    top: 28%;
    left: 22%;
    animation: float 11s ease-in-out infinite reverse;
  }

  .orb-3 {
    width: min(12vw, 14rem);
    height: min(12vw, 14rem);
    background: radial-gradient(circle, rgba(196, 30, 58, 0.4) 0%, transparent 70%);
    bottom: 24%;
    right: 18%;
    animation: float 9s ease-in-out infinite 1s;
  }

  /* ======== RINGS (castle columns) ======== */
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(196, 30, 58, 0.2);
  }

  .ring-outer {
    width: min(32vw, 42rem);
    height: min(32vw, 42rem);
    border-color: rgba(196, 163, 90, 0.15);
    animation: spin 40s linear infinite;
  }

  .ring-mid {
    width: min(24vw, 30rem);
    height: min(24vw, 30rem);
    border-style: dashed;
    border-color: rgba(122, 21, 40, 0.25);
    animation: spin 28s linear infinite reverse;
  }

  .ring-inner {
    width: min(14vw, 18rem);
    height: min(14vw, 18rem);
    border-color: rgba(232, 54, 79, 0.3);
    animation: spin 18s linear infinite;
  }

  /* ======== VINE CROSS (thorns + roses) ======== */
  .vine-cross {
    position: absolute;
    width: min(22vw, 28rem);
    height: min(22vw, 28rem);
  }

  .vine {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(196, 163, 90, 0.25), transparent);
  }

  .vine-h {
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
  }

  .vine-v {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(180deg, transparent, rgba(196, 163, 90, 0.25), transparent);
  }

  /* Thorns */
  .thorn {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1.5px solid rgba(122, 21, 40, 0.5);
    border-left: none;
    border-bottom: none;
  }

  .thorn-l { left: 20%; top: 50%; transform: translateY(-50%) rotate(-45deg); }
  .thorn-r { right: 25%; top: 50%; transform: translateY(-50%) rotate(135deg); }
  .thorn-u { top: 30%; left: 50%; transform: translateX(-50%) rotate(45deg); }
  .thorn-d { bottom: 25%; left: 50%; transform: translateX(-50%) rotate(-135deg); }

  /* Rose blossom markers */
  .rose-blossom {
    position: absolute;
    font-size: 2.4rem;
    opacity: 0.3;
    color: var(--primary-bright);
  }

  .rose-top { top: -0.8rem; left: 50%; transform: translateX(-50%); }
  .rose-bottom { bottom: -0.8rem; left: 50%; transform: translateX(-50%); }

  /* ======== CORNER ROSE CLUSTERS ======== */
  .corner-rose {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.15;
  }

  .corner-tr {
    top: 3rem;
    right: 3rem;
  }

  .corner-bl {
    bottom: 3rem;
    left: 3rem;
  }

  .rose-icon {
    font-size: 2.4rem;
    color: var(--primary-bright);
  }

  .thorn-line {
    width: 1px;
    height: 4rem;
    background: linear-gradient(180deg, var(--gold) 0%, transparent 100%);
    position: relative;
  }

  .corner-tr .thorn-line { background: linear-gradient(180deg, transparent 0%, var(--gold) 100%); }

  .corner-bl .thorn-line::after,
  .corner-tr .thorn-line::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    border: 1.5px solid var(--primary-deep);
    border-left: none;
    border-bottom: none;
  }

  .corner-bl .thorn-line::after {
    top: 0;
    left: -3px;
    transform: rotate(45deg);
  }

  .corner-tr .thorn-line::after {
    bottom: 0;
    left: -3px;
    transform: rotate(-135deg);
  }

  /* ======== STAGE LABEL ======== */
  .stage-label {
    position: absolute;
    bottom: 4.8rem;
    left: 4.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 1.3rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stage-label .year {
    padding-left: 1.7rem;
    color: var(--gold);
    opacity: 0.7;
    font-size: 1.1rem;
  }

  /* ======== ANIMATIONS ======== */
  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-18px) scale(1.03); }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
