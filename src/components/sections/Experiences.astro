---
import { experiences } from '../../data/content';
const exp = experiences();
---

<section class="section section-experiences" id="experience">
  <div class="tf-container">
    <div class="content-col">
      <h2 class="desc reveal">
        From GPU inference on financial streams to mobile architecture at scale — systems built to last under load
      </h2>
      <div class="experiences-wrap">
        {exp.map((e: any) => (
          <div class="item reveal">
            <div class="sub-heading text">{e.company}</div>
            <div class="job-title">
              <h3 class="title h6">{e.role}</h3>
              <div class="text-body-2 time-line type-tags">{e.period}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
