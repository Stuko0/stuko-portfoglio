---
import ServicesAccordion from '../islands/ServicesAccordion';
import { services } from '../../data/content';
const sr = services();
---

<section class="section section-services" id="services">
  <div class="tf-container">
    <div class="content-col">
      <div class="section-services-inner">
        <div class="text-body-2 dot-before subtitle">What I Build</div>
        <ServicesAccordion client:visible data={sr} />
        <div class="more-infor reveal">
          <div class="worldwide text-body-2">
            <span aria-hidden="true">♛</span>
            Available <span>Remote Worldwide</span>
          </div>
          <a class="text-body-1 link btn-royal btn-royal-outline" href="#contact">
            Contact me
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
