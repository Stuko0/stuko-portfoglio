---
import BudgetChooser from '../islands/BudgetChooser';
import { budgetOptions } from '../../data/content';
const bOpts = budgetOptions();
---

<section class="section section-contact" id="contact">
  <div class="tf-container">
    <div class="content-col">
      <div class="section-contact-inner">
        <div class="text-body-2 dot-before subtitle">Contact</div>
        <h2 class="fw-medium heading">
          Contact For<br />Systems Work
        </h2>
        <p class="contact-decree">
          By Royal Decree — present your proposal to the court.<br />
          All serious engagements are welcome.
        </p>
        <form class="form-contact" method="post" id="form-contact" novalidate>
          <fieldset class="fiel-mail">
            <label class="text-xs" for="mail">Your Email</label>
            <input
              type="email"
              name="mail"
              id="mail"
              placeholder="Enter the Email"
              required
              autocomplete="email"
            />
          </fieldset>
          <fieldset class="fiel-phone">
            <label class="text-xs" for="phone">Your Phone</label>
            <input
              type="tel"
              name="phone"
              id="phone"
              placeholder="Enter your phone number"
              autocomplete="tel"
            />
          </fieldset>
          <fieldset class="fiel-text">
            <label class="text-xs" for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell me about your project..." required
            ></textarea>
          </fieldset>
          <BudgetChooser client:visible data={bOpts} />
          <div class="bot-btn send-wrap">
            <button type="submit" id="btn-contact-submit" class="text-body-2 fw-medium btn-royal">
              <span class="flex-grow-1 text-start">Get Started</span>
              <span aria-hidden="true">↗</span>
            </button>
          </div>
        </form>
        <script>
          const form = document.getElementById('form-contact');
          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = form.querySelector('#btn-contact-submit span:first-child');
            if (btn) {
              const prev = btn.textContent;
              btn.textContent = 'Message sent ✓';
              setTimeout(() => {
                btn.textContent = prev;
                (form as HTMLFormElement).reset();
              }, 2200);
            }
          });
        </script>
      </div>
    </div>
  </div>
</section>
