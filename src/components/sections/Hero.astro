---
import LocalTime from '../islands/LocalTime';
import Counter from '../islands/Counter';
import { site, tags, stats, heroTitle } from '../../data/content';
const s = site();
const t = tags();
const st = stats();
const ht = heroTitle();
---

<section class="section-hero" id="home">
  <!-- Floating rose petals — crimson paper cutouts over the parchment -->
  <div class="hero-petals" aria-hidden="true">
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
    <div class="petal"></div>
  </div>
  <div class="tf-container" style="position: relative; z-index: 1;">
    <div class="content-col" style="position: relative;">
      <LocalTime client:load location={s.location} />
      <div class="main-title">
        <span class="hero-ornament" aria-hidden="true">♛ · ♡ · ♛</span>
        <div class="text-body-1 dot-before subtitle">{ht.subtitle}</div>
        <h1 class="title text-display-1">
          {ht.line1} <em>{ht.line2}</em>
        </h1>
        <div class="text-body-2 text">{s.intro}</div>
      </div>
      <div class="indicators">
        <ul class="list-tags">
          {t.map((tag) => (
            <li>
              <a class="text-body-2" href="#services">{tag}</a>
            </li>
          ))}
        </ul>
        <div class="indicators-wrap">
          {st.map((stat: any) => (
            <div class="indicators-item">
              <div class="text-body-1 dot-before indicators-title">{stat.label}</div>
              <Counter client:visible value={stat.value} suffix={stat.suffix} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
