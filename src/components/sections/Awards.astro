---
import { awards } from '../../data/content';
const aw = awards();
---

<section class="section section-awards" id="awards">
  <div class="tf-container">
    <div class="content-col">
      <h2 class="visually-hidden">Awards &amp; Certifications</h2>
      <div class="awards-list">
        {aw.map((award: any) => (
          <div class="award-item reveal">
            <span class="number fw-medium">{award.number}</span>
            <h3 class="title fw-medium">{award.title}</h3>
            <div class="time text-body-1">{award.date}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
